            "type" : "integer",
            "format" : "int32"
          },
          "title" : {
            "type" : "string"
          },
          "type" : {
            "type" : "string"
          }
        },
        "required" : [ "code", "status" ]
      },
      "EmailCodeRequest" : {
        "type" : "object",
        "properties" : {
          "email" : {
            "type" : "string",
            "format" : "email",
            "maxLength" : 320,
            "minLength" : 0
          }
        },
        "required" : [ "email" ]
      },
      "LoginRequest" : {
        "type" : "object",
        "properties" : {
          "email" : {
            "type" : "string",
            "format" : "email",
            "maxLength" : 320,
            "minLength" : 0
          },
          "password" : {
            "type" : "string"
          }
        },
        "required" : [ "email", "password" ]
      },
      "RefreshRequest" : {
        "type" : "object",
        "properties" : {
          "refreshToken" : {
            "type" : "string",
            "minLength" : 1
          }
        },
        "required" : [ "refreshToken" ]
      },
      "ResetPasswordRequest" : {
        "type" : "object",
        "properties" : {
          "newPassword" : {
            "type" : "string"
          },
          "resetToken" : {
            "type" : "string",
            "minLength" : 1
          }
        },
        "required" : [ "newPassword", "resetToken" ]
      },
      "SignupRequest" : {
        "type" : "object",
        "properties" : {
          "consents" : {
            "type" : "array",
            "items" : {
              "type" : "string",
              "enum" : [ "TERMS_OF_SERVICE", "PRIVACY_POLICY", "AI_DATA_TRANSFER", "AGE_14_OR_OLDER" ]
            },
            "uniqueItems" : true
          },
          "name" : {
            "type" : "string",
            "maxLength" : 20,
            "minLength" : 0
          },
          "password" : {
            "type" : "string"
          },
          "screenSize" : {
            "type" : "string",
            "enum" : [ "SMALL", "MEDIUM", "LARGE" ]
          },
          "signupToken" : {
            "type" : "string",
            "minLength" : 1
          }
        },
        "required" : [ "consents", "name", "password", "screenSize", "signupToken" ]
      },
      "TokenResponse" : {
        "type" : "object",
        "properties" : {
          "accessToken" : {
            "type" : "string"
          },
          "accessTokenExpiresAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "refreshToken" : {
            "type" : "string"
          },
          "refreshTokenExpiresAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "userId" : {
            "type" : "integer",
            "format" : "int64"
          }
        }
      },
      "VerifyEmailCodeRequest" : {
        "type" : "object",
        "properties" : {
          "code" : {
            "type" : "string",
            "minLength" : 1,
            "pattern" : "\\d{6}"
          },
          "email" : {
            "type" : "string",
            "format" : "email",
            "maxLength" : 320,
            "minLength" : 0
          }
        },
        "required" : [ "code", "email" ]
      },
      "VerifyEmailCodeResponse" : {
        "type" : "object",
        "properties" : {
          "expiresAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "signupToken" : {
            "type" : "string"
          }
        }
      },
      "VerifyResetCodeRequest" : {
        "type" : "object",
        "properties" : {
          "code" : {
            "type" : "string",
            "minLength" : 1,
            "pattern" : "\\d{6}"
          },
          "email" : {
            "type" : "string",
            "format" : "email",
            "maxLength" : 320,
            "minLength" : 0
          }
        },
        "required" : [ "code", "email" ]
      },
      "VerifyResetCodeResponse" : {
        "type" : "object",
        "properties" : {
          "expiresAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "resetToken" : {
            "type" : "string"
          }
        }
      }
    },
    "securitySchemes" : {
      "bearer" : {
        "bearerFormat" : "JWT",
        "scheme" : "bearer",
        "type" : "http"
      }
