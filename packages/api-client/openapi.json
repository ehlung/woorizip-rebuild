  "components" : {
    "schemas" : {
      "ApiFieldError" : {
        "type" : "object",
        "properties" : {
          "field" : {
            "type" : "string"
          },
          "message" : {
            "type" : "string"
          }
        },
        "required" : [ "field", "message" ]
      },
      "ApiProblem" : {
        "type" : "object",
        "properties" : {
          "code" : {
            "type" : "string",
            "enum" : [ "BAD_REQUEST", "VALIDATION_FAILED", "UNAUTHORIZED", "FORBIDDEN", "NOT_FOUND", "METHOD_NOT_ALLOWED", "UNSUPPORTED_MEDIA_TYPE", "TOO_MANY_REQUESTS", "EMAIL_CODE_INVALID", "EMAIL_CODE_EXPIRED", "SIGNUP_TOKEN_INVALID", "EMAIL_ALREADY_REGISTERED", "PASSWORD_RESET_TOKEN_INVALID", "LOGIN_FAILED", "LOGIN_LOCKED", "PASSWORD_RESET_REQUIRED", "REFRESH_TOKEN_INVALID", "INTERNAL_ERROR" ]
          },
